# 学割ナビ 環境変数のサンプル
# このファイルを .env にコピーして値を入れてください。.env は絶対にGitにコミットしないこと。

# Flask
SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=development

# --- Azure Storage の設定（どちらか一方） ---

# 方法A: 接続文字列（学校環境で権限が限られる場合の簡易方式）
# AZURE_STORAGE_CONNECTION_STRING=<Azure Portal のストレージアカウント→「アクセス キー」から取得した接続文字列をここに入力>
# ※ 実際の値は .env にだけ書き、この .env.example には絶対に書かないこと

# 方法B: マネージドID / Azure CLI ログインで使う場合（推奨）
# AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount

# テーブル名・コンテナー名（通常は変更不要）
AZURE_TABLE_POSTS=Posts
AZURE_TABLE_COMMENTS=Comments
AZURE_BLOB_CONTAINER=post-images

# アップロード上限（バイト数）。デフォルト 5MB
MAX_UPLOAD_BYTES=5242880
